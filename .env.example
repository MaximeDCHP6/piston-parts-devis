# Copier ce fichier en ".env.local" et renseigner les valeurs depuis
# Supabase > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète, jamais exposée au navigateur. Utilisée uniquement dans les
# routes serveur (ex. page publique /devis/[token], upload de fichiers).
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application, utilisée pour construire le lien
# sécurisé envoyé au client final (ex. http://localhost:3000 en dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000
